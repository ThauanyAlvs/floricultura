{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "npm: dev (8080)",
      "type": "shell",
      "command": "npm.cmd",
      "args": [
        "run",
        "dev"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "nextjs",
        "severity": "info",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": ".*(started server on|Ready in |Local:).*",
          "message": 0
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": ".*(started server on|Ready in |Local:).*"
        }
      }
    }
  ]
}